# 복사해서 .env 로 만든 뒤 사용한다 (PowerShell: Copy-Item .env.example .env). .env 는 Git 에 올리지 않는다.
# 아래 값은 로컬 개발 전용 자리표시자다. 다른 환경의 비밀번호를 재사용하지 말고, 공유·운영 환경에는 절대 쓰지 않는다.

# --- Docker Compose (compose.yaml) ---
POSTGRES_ADMIN_USER=chungpamo_admin
POSTGRES_ADMIN_PASSWORD=change_me_admin_dev_only
APP_DB_USER=chungpamo_app
APP_DB_PASSWORD=change_me_app_dev_only
# 호스트 노출 포트(127.0.0.1 한정). 다른 프로젝트와 충돌하면 이 값만 바꾼다.
DB_HOST_PORT=55432

# --- Backend (backend/app/config.py) --- 포트·비밀번호를 위 값과 맞춘다
DATABASE_URL=postgresql+psycopg://chungpamo_app:change_me_app_dev_only@127.0.0.1:55432/chungpamo

# --- 배치 저장 API (POST /batches 등). 기본 disabled → 501 PERSISTENCE_DISABLED.
# Docker 전용 DB와 마이그레이션 0005를 적용·검증한 PC에서 postgres로 바꾼다.
PERSISTENCE=disabled

# --- 브라우저 허용 출처 (쉼표 구분). 비우면 CORS 를 켜지 않는다. '*' 는 서버가 거부한다. 예: http://127.0.0.1:5173
CORS_ALLOW_ORIGINS=
