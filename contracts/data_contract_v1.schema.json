        "base_unit"
      ],
      "title": "MaterialRow",
      "type": "object"
    },
    "MonthlyDemandRow": {
      "additionalProperties": false,
      "description": "제품별 월별 수요 실적/주문 합계. 예측 모듈의 입력.",
      "properties": {
        "demand_qty": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Demand Qty"
        },
        "period": {
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$",
          "title": "Period",
          "type": "string"
        },
        "product_id": {
          "maxLength": 40,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$",
          "title": "Product Id",
          "type": "string"
        },
        "unit": {
          "maxLength": 40,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "product_id",
        "period",
        "demand_qty",
        "unit"
      ],
      "title": "MonthlyDemandRow",
      "type": "object"
    },
    "ProductRow": {
      "$defs": {
        "ProductType": {
          "enum": [
            "FINISHED",
            "SEMI_FINISHED"
          ],
          "title": "ProductType",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "properties": {
        "base_unit": {
          "maxLength": 40,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$",
          "title": "Base Unit",
          "type": "string"
        },
        "product_id": {
          "maxLength": 40,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$",
          "title": "Product Id",
          "type": "string"
        },
        "product_name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Product Name",
          "type": "string"
        },
        "product_type": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProductType"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "safety_stock_qty": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "default": "0",
          "title": "Safety Stock Qty"
        }
      },
      "required": [
        "product_id",
        "product_name",
        "base_unit"
      ],
      "title": "ProductRow",
      "type": "object"
    },
    "SalesOrderRow": {
      "additionalProperties": false,
      "properties": {
        "due_date": {
          "format": "date",
          "title": "Due Date",
          "type": "string"
        },
        "order_date": {
          "format": "date",
          "title": "Order Date",
          "type": "string"
        },
        "order_id": {
          "maxLength": 40,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$",
          "title": "Order Id",
          "type": "string"
        },
        "order_qty": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Order Qty"
        },
        "product_id": {
          "maxLength": 40,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$",
          "title": "Product Id",
          "type": "string"
        },
        "status": {
          "pattern": "^(OPEN|CLOSED|CANCELLED)$",
          "title": "Status",
          "type": "string"
        },
        "unit": {
          "maxLength": 40,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$",
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "order_id",
        "product_id",
        "order_qty",
        "unit",
        "order_date",
        "due_date",
        "status"
      ],
      "title": "SalesOrderRow",
      "type": "object"
    },
    "UnitRow": {
      "$defs": {
        "UnitDimension": {
          "enum": [
            "COUNT",
            "MASS",
            "TIME"
          ],
          "title": "UnitDimension",
